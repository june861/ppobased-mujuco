    "version": "0.2.0",
    "configurations": [
        {
            "name": "mujoco appo",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "console": "integratedTerminal",
            "args": [
                "--env_type", "mujoco",
                "--seed", "1",
                "--env_id", "Ant-v5",
                "--yaml",  "${workspaceFolder}/src/conf/con_appo_run.yaml",
                "--algo", "appo",
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
              },
            "justMyCode": true,
        },
        {
            "name": "mujoco ppo-clip",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "console": "integratedTerminal",
            "args": [
                "--env_type", "mujoco",
                "--seed", "1",
                "--env_id", "Ant-v5",
                "--yaml", "${workspaceFolder}/src/conf/con_ppo1_run.yaml",
                "--algo", "ppo-penalty",
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
              },
            "justMyCode": true,
        },
        {
            "name": "mujoco ppo-kl",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "console": "integratedTerminal",
            "args": [
                "--env_type", "mujoco",
                "--seed", "1",
                "--env_id", "Ant-v5",
                "--yaml", "${workspaceFolder}/src/conf/con_spo_run.yaml",
                "--algo", "spo",
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
              },
            "justMyCode": true,
        },

        {
            "name": "atari appo & ppo-clip",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "console": "integratedTerminal",
            "args": [
                "--env_type", "atari",
                "--seed", "1",
                "--env_id", "KungFuMasterNoFrameskip-v4",
                "--yaml", "${workspaceFolder}/src/conf/dis_exp_run.yaml",
                "--algo", "ppo-clip",
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
              },
            "justMyCode": true,
        },

        {
            "name": "atari ppo-penalty",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "console": "integratedTerminal",

        {
            "name": "mujoco appo",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "console": "integratedTerminal",
            "args": [
                "--env_type", "mujoco",
                "--seed", "1",
                "--env_id", "HumanoidStandup-v4",
